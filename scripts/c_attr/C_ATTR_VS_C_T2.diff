+def cmd_compare(a) -> None:
+    """rc 0 when the first 50 manifest items are identical strings, rc 3 otherwise; prints counts and ids only."""
+    old = stored_run(Path(a.old)) if a.stored else None
+    ids = [i for i, _f, _h in items_of(a.set, a)][:REDECODE_N]
+    if a.dry_run:
+        print(f"DRY compare {a.name}: {len(ids)} ids; reference {'pinned' if a.stored else 'a host run'}; rc 3")
+        sys.exit(3)
+    new = json.loads(Path(a.new).read_text(encoding="utf-8"))
+    old = old or json.loads(Path(a.old).read_text(encoding="utf-8"))
+    bad = differing(new, old, ids)
+    rec = {"label": LABEL, "check": a.name, "n": len(ids), "identical": len(ids) - len(bad), "failing_ids": bad,
+           "new_sha256": sha(a.new), "old_sha256": sha(a.old), "utc": lb.utc()}
+    Path(a.out).write_text(json.dumps(rec) + "\n", encoding="utf-8")
+    print(f"{a.name}: {rec['identical']}/{rec['n']} identical; failing ids {bad}")
+    sys.exit(3 if bad else 0)

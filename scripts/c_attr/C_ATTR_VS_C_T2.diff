+def stored_run(p: Path) -> dict:
+    """A stored C / C-T1 run file, admitted only by its pin in STORED_SHA256."""
+    if sha(p) not in {ln.split()[0] for ln in RESTORED.read_text().splitlines() if ln.strip()}:
+        raise SystemExit(f"{p}: not a pinned stored run")
+    return json.loads(Path(p).read_text(encoding="utf-8"))
+
+
+def as_run(p: Path) -> dict:
+    """A run for the scorer: a C-ATTR / C-T1 record as written, or a pinned stored C run in the C-T1 layout."""
+    r = json.loads(Path(p).read_text(encoding="utf-8"))
+    if r.get("schema") != SCHEMA:
+        r = stored_run(Path(p))
+        r = {**r, "schema": SCHEMA, "c2_source": Path(p).name,
+             "spec": {**r["spec"], "draw": 0, "memory": "vi", "img_examples": False}}
+    return r | {"_sha256": sha(p)}
+

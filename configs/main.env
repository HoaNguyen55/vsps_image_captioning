# Every hyperparameter of the main VSPS system, in one place. Read by the
# Makefile (make syntax; `?=` so the environment or `make VAR=...` overrides).

PYTHON         ?= python3
NCS_DATA       ?= $(CURDIR)/ncs-data
SEED           ?= 42
SEEDS          ?= 42 43 44

# Phase 1a: generation + dual-query verification (scripts/generate_stage1.py)
# 1 = unpack the shipped data/stage1_records instead of regenerating (~30 GPU-h)
STAGE1_SHIPPED ?= 0
SOURCE_SPLIT   ?= train_data.json
GENERATOR      ?= qwen2.5-vl-7b
VERIFIER       ?= vintern-1b
MAX_ENTITIES   ?= 8
MAX_PAIRS      ?= 8
VERIFIER_TILES ?= 4
SHARD          ?= 0
SHARDS         ?= 1

# Step (3): offline neutralization (scripts/person_uncap.py)
UNCAP_TYPES    ?= entity,attribute,action,counting

# Step (4): selection + rendering (scripts/build_dpo_data.py); main system = variant B
BUDGET         ?= 9
VARIANT        ?= B
MIN_SUPPORTED  ?= 1
SUP_SEED       ?= 42
SUP_FLAGS      ?= --style-variation --clean-props

# Phase 1b: QLoRA SFT (scripts/train_stage2.py)
EPOCHS         ?= 2
LR             ?= 1e-4
GRAD_ACCUM     ?= 8
LORA_R         ?= 16
LORA_ALPHA     ?= 32
# 0 = chosen from the card's memory
VISION_TOKENS  ?= 0

# Phase 2: inference + scoring (scripts/evaluate.py)
MODEL          ?= qwen2.5-vl-7b
EVAL_SPLIT     ?= test_data.json
MAX_NEW_TOKENS ?= 160
MAX_VIS_TOKENS ?= 512
SEGMENTER      ?= rdrsegmenter
# extra evaluate.py switches, e.g. --four-bit
EVAL_FLAGS     ?=

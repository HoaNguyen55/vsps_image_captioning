 "analysis": {
  "items_and_labels": "every (image, class) whose class one of the 13 pool captions names (plan_f1.items); y = class in ktvic5 gold (plan_f1.labels)",
  "cell": "v = share of the 12 samples naming the class; g = 1 if the greedy caption names it; cell = round(12*v)*2 + g (the knn_prior_eval convention)",
  "A_within": "knn_prior_eval.cell_auc(p_with, cell, y) over the N13 items: positive-negative pairs pooled over cells, ties count one half",
  "A_noimg": "plan_f1.auroc(p_without, y): marginal AUROC over all N13 items, ties averaged",
  "no_image_reading": "The plan's 'no-image AUROC' is the marginal AUROC of the no-image score: R14-3 states its no-image reference point as a marginal AUROC (scripts/probe_existence.py), and a no-image threshold above the within-cell one is coherent only for a different statistic. The within-cell no-image AUROC is reported, not gated.",
  "reported_not_gating": [
   "cell_auc(p_without, cell, y)",
   "plan_f1.auroc(p_with, y)",
   "all four statistics on the N7_T0.5 sub-pool (greedy + 6 T0.5 samples; cell = round(6*v)*2 + g)",
   "item and pair counts per cell"
  ],
  "ci": {
   "method": "image-clustered percentile bootstrap over the dev images",
   "B": 2000,
   "rng": "numpy default_rng(0)",
   "level": "95%",
   "role": "reported; the gate uses point estimates"
  },
  "dev_readout": {
   "runs_only_if": "G0 PASS",
   "pool": "N7_T0.5: greedy + 6 samples at T* = 0.5 (UPE-MBR's registered T* and pool size)",
   "rule": "XV-EF1 = the UPE-MBR rule with q_o = p_with(o): U(c) = upe_mbr.utilities base (self-MBR + retrieval CIDEr-D, train-minus-dev300 references) + LAM*10*EF1_V(c), EF1_V(c) = 2*sum over o in M(c) of p_with(o) / (|M(c)| + EG); upe_mbr.pick keeps the greedy caption unless another wins by more than MARGIN",
   "controls": {
    "COUNT": "upe_mbr.count_matched: q_o = 1, lam on COUNT_GRID matched to XV-EF1's mean classes per caption, ties to the smaller lam",
    "XV-EF1-noimg": "the same rule with p_without, with its own COUNT match (prior-leak control)"
